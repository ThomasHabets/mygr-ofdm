- name: epy_block_0
  id: epy_block
  parameters:
    M: bucket
    N: buckets
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\nimport numpy as np\nimport\
      \ random\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"\
      Place each complex input sample at index M of an N-element vector.\"\"\"\n\n\
      \    def __init__(self, N=64, M=0, mag = 0.5):\n        if N <= 0:\n       \
      \     raise ValueError(\"N must be positive\")\n        if not 0 <= M < N:\n\
      \            raise ValueError(\"M must satisfy 0 <= M < N\")\n\n        self.N\
      \ = int(N)\n        self.M = int(M)\n        self.mag = mag\n\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Complex to sparse vector\",\n       \
      \     in_sig=[np.complex64],\n            out_sig=[(np.complex64, self.N)],\n\
      \        )\n\n    def work(self, input_items, output_items):\n        src =\
      \ input_items[0]\n        dst = output_items[0]\n\n        n = len(src)\n  \
      \      center = self.N // 2\n        dst.fill(0)\n        dst[:, center] = 1.0\
      \ + 0.0j\n        for i in range(self.N):\n            if abs(i - center) >=\
      \ 5:\n                #dst[:, i] = self.mag*(random.random() + random.random()\
      \ * 1.0j)\n                #dst[:, i] = self.mag * ( np.random.random(n) + 1.0j\
      \ * np.random.random(n))\n                dst[:, i] = self.mag * np.exp(1.0j\
      \ * 2.0 * np.pi * np.random.random(n))\n        dst[:, self.M] = src\n\n   \
      \     return n\n"
    affinity: ''
    alias: ''
    comment: ''
    mag: other_mag
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Complex to sparse vector', 'blk', [('N', '64'), ('M', '0'), ('mag',
      '0.5')], [('0', 'complex', 1)], [('0', 'complex', 64)], 'Place each complex
      input sample at index M of an N-element vector.', ['M', 'N', 'mag'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 176.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ fft_len=64, samp_rate=1e6, ref_bin=512):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Jacobsen CFO Estimator\",\n         \
      \   in_sig=[(np.complex64, fft_len)],\n            out_sig=[np.float32],\n \
      \       )\n\n        self.fft_len = fft_len\n        self.samp_rate = samp_rate\n\
      \        self.ref_bin = ref_bin\n\n    def work(self, input_items, output_items):\n\
      \        inp = input_items[0]\n        out = output_items[0]\n\n        k =\
      \ self.ref_bin\n        bin_width = self.samp_rate / self.fft_len\n\n      \
      \  for i, fft in enumerate(inp):\n            xm1 = fft[k - 1]\n           \
      \ x0  = fft[k]\n            xp1 = fft[k + 1]\n\n            denom = 2.0 * x0\
      \ - xm1 - xp1\n\n            if abs(denom) > 1e-20:\n                delta =\
      \ np.real((xm1 - xp1) / denom)\n                out[i] = delta * bin_width\n\
      \            else:\n                out[i] = 0.0\n\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: FFT pilot tracking frequency evaluation.
    fft_len: buckets
    maxoutbuf: '0'
    minoutbuf: '0'
    ref_bin: buckets//2
    samp_rate: samp_rate*sps*buckets
  states:
    _io_cache: ('Jacobsen CFO Estimator', 'blk', [('fft_len', '64'), ('samp_rate',
      '1000000.0'), ('ref_bin', '512')], [('0', 'complex', 64)], [('0', 'float', 1)],
      '', ['fft_len', 'ref_bin', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2352, 440.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    M: bucket
    N: buckets
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"\n    Input:\
      \  complex vector of length N\n    Output: complex scalar, equal to input[M]\n\
      \    \"\"\"\n\n    def __init__(self, N=64, M=0):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Vector Bucket Select\",\n           \
      \ in_sig=[(np.complex64, N)],\n            out_sig=[np.complex64],\n       \
      \ )\n\n        self.N = N\n        self.M = M\n\n        if not 0 <= M < N:\n\
      \            raise ValueError(f\"M must be in [0, {N})\")\n\n    def work(self,\
      \ input_items, output_items):\n        inp = input_items[0]\n        out = output_items[0]\n\
      \n        out[:] = inp[:, self.M]\n\n        return len(out)\n"
    affinity: ''
    alias: ''
    comment: Decode of our relevant subcarrier.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Vector Bucket Select'', ''blk'', [(''N'', ''64''), (''M'', ''0'')],
      [(''0'', ''complex'', 64)], [(''0'', ''complex'', 1)], ''\nInput:  complex vector
      of length N\nOutput: complex scalar, equal to input[M]\n'', [''M'', ''N''])'
    bus_sink: false
    bus_source: false
